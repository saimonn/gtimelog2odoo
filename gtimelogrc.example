[gtimelog_exporter]
jira_url = https://jira.mydomain.com/
tempo_url = https://api.tempo.io/4
jira_account_email = toto@example.com
odoo_url = https://odoo.mydomain.com/
odoo_port = 443
odoo_protocol = jsonrpc+ssl
odoo_db = awesome_db_name
odoo_user = my-user
line_format = standard

# autosubmit can be 'ask' (default) 'never', or 'always'.
# wether to submit the timesheet after importing gtimesheets into odoo.
#autosubmit = ask

[gtimelog_exporter:aliases]
my-alias = ABC-42
other-alias = XYZ-14
